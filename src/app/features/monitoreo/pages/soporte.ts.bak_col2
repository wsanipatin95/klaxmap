import { Component, inject, signal } from '@angular/core';
import { DecimalPipe } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { NocApi } from '../services/noc-api';
import { NocNotify } from '../services/noc-notify';
import { Bandeja } from './bandeja';

/**
 * Módulo Soporte (Fase 1). Busca cliente, abre ticket con datos de red en vivo,
 * diagnostica con botones (rellenan texto), acciones de consulta + ping (quedan en el
 * historial) y genera la orden técnica ya llena. No toca equipos.
 */
@Component({
  selector: 'app-soporte',
  standalone: true,
  imports: [FormsModule, DecimalPipe, RouterLink, Bandeja],
  template: `
    <div class="tools">
      <span style="font-weight:700;font-size:16px">🎧 Soporte</span>
    </div>

    @if (view()==='bandeja') {
      <app-bandeja (abrir)="abrirPorContrato($event)"></app-bandeja>
    }

    @if (view()==='ticket' && ticket(); as t) {
      <a class="back" (click)="view.set('bandeja')">← Volver a la bandeja</a>

      <div class="fbox">
        <div class="fhd">
          <div class="fav">{{ (cf('nombre','cliente','representante') || t.cliente || '?').slice(0,2).toUpperCase() }}</div>
          <div class="fwho">
            <div class="nm">{{ cf('nombre','cliente','representante') || t.cliente }}</div>
            <div class="cn">CI/RUC {{ cf('ruc','cedula','dni','documento') || '—' }} · contrato {{ t.contrato || '—' }}@if (t.idTic) { · ticket #{{ t.idTic }} }</div>
          </div>
          <div class="fst">
            @if (cf('estado','estado_contrato','con_estado')) { <span class="cpill">{{ cf('estado','estado_contrato','con_estado') }}</span> }
            <span [innerHTML]="stBadge(t.phase_state)"></span>
          </div>
        </div>

        <div class="cinfo">
          <div><span>Teléfono</span><b class="mono">{{ cf('movil','telefono','celular') || t.movil || '—' }}</b></div>
          <div><span>Plan</span><b>{{ cf('numero_megas','megas','plan') ? cf('numero_megas','megas','plan') + ' Mbps' : '—' }}</b></div>
          <div><span>Dirección</span><b>{{ cf('direccion','direccion_domicilio','dir') || '—' }}</b></div>
          <div><span>Nodo · VLAN</span><b>{{ cf('nodo','vlan','vlan_red') || '—' }}</b></div>
        </div>

        <div class="kpis">
          <div class="kpi"><div class="k">Estado ONU</div><div class="v" [innerHTML]="stBadge(t.phase_state)"></div></div>
          <div class="kpi"><div class="k">Potencia RX</div><div class="v" [style.color]="rxColor(t.rx_dbm)">{{ t.rx_dbm!=null ? (t.rx_dbm | number:'1.2-2')+' dBm' : '—' }}</div></div>
          <div class="kpi"><div class="k">OLT</div><div class="v s">{{ t.olt_name || '—' }}</div></div>
          <div class="kpi"><div class="k">IP cliente</div><div class="v s mono">{{ t.client_ip || '—' }}</div></div>
          <div class="kpi"><div class="k">PON · ONU</div><div class="v s mono">{{ t.pon }} · {{ t.onu_num ?? '—' }}</div></div>
          <div class="kpi"><div class="k">Distancia</div><div class="v s">{{ t.distance_m!=null ? t.distance_m+' m' : '—' }}</div></div>
          <div class="kpi"><div class="k">Consumo ↓/↑</div><div class="v s">{{ rate(t.out_rate_bps) }} / {{ rate(t.in_rate_bps) }}</div></div>
          <div class="kpi"><div class="k">Contrato</div><div class="v s mono">{{ t.contrato || '—' }}</div></div>
        </div>

        <div class="cbar">
          <button class="btn2 wa" [disabled]="!(cf('movil','telefono','celular') || t.movil)" (click)="waCliente()">💬 WhatsApp</button>
          <a class="btn2" [href]="'tel:'+(cf('movil','telefono','celular') || t.movil || '')" style="text-decoration:none">📞 Llamar</a>
          <span class="note" style="margin:0 6px">envío por Omni: en integración</span>
          <div style="flex:1"></div>
          @if (t.idTic) {
            <button class="btn2 primary" (click)="tomarTicket(t)">🙋 Tomar</button>
            <select class="isel" [(ngModel)]="nuevoEstado"><option [ngValue]="null">Estado…</option>@for (e of estadosCat(); track e.id) { <option [ngValue]="e.id">{{ e.nombre }}</option> }</select>
            <button class="btn2" [disabled]="nuevoEstado==null" (click)="cambiarEstado(t)">Aplicar</button>
          }
        </div>
      </div>

      <div class="fgrid2">
        <div class="fcard">
          <div class="ft">🛰️ Servicios y acciones</div>
          <div class="fb">
            <div class="chips">
              <button class="chip" (click)="runAction('estado')">Estado</button>
              <button class="chip" (click)="runAction('potencia')">Potencia</button>
              <button class="chip" (click)="runAction('caidas')">Caídas</button>
              <button class="chip" (click)="runAction('consumo')">Consumo</button>
              <button class="chip" (click)="runAction('ping')">Ping</button>
              <button class="chip" (click)="copyIp()">Copiar IP</button>
            </div>
            @if (lastResult()) { <div class="res">{{ lastResult() }}</div> }
            <div class="sub">Diagnóstico</div>
            <div class="chips">
              @for (d of diagBtns; track d.l) { <button class="chip" (click)="addDiag(d.t)">{{ d.l }}</button> }
            </div>
            <textarea class="isel ta" rows="3" [(ngModel)]="diag" placeholder="Diagnóstico…"></textarea>
            <div class="rowbtns">
              <button class="btn2 xs" (click)="saveDiag()">💾 Guardar</button>
              <button class="btn2 xs" (click)="copyDiag()">📋 Copiar</button>
              <button class="btn2 xs ok" (click)="setEstado('Solucionado','Solucionado remoto')">✅ Solucionado</button>
              <button class="btn2 xs" (click)="showOrder.set(true)">🔧 Orden</button>
            </div>
            <div class="sub">Log de acciones</div>
            <div class="tl">
              @for (e of t.log; track $index) { <div class="it"><span class="tm">{{ e.hora }}</span><span class="tx"><b>{{ e.usuario }}</b> {{ e.accion }}{{ e.resultado ? ' → ' + e.resultado : '' }}</span></div> }
              @empty { <div class="note">Sin acciones todavía.</div> }
            </div>
          </div>
        </div>

        <div class="fcol">
        <div class="fcard">
          <div class="ft">📶 Router · TR-069</div>
          <div class="fb">
          @if (acs(); as a) {
            @if (acsWrite() === false) {
              <div style="display:flex;gap:8px;align-items:center;background:#fff7ed;border:1px solid #fdba74;border-radius:10px;padding:8px 10px;margin-bottom:8px;font-size:12.5px;color:#9a3412">
                <span>🔒 Escritura ACS deshabilitada.</span>
                <button class="btn2 xs" style="margin-left:auto" (click)="activarEscritura()">Activar</button>
              </div>
            }
            <div class="rmeta">
              <div><span>Equipo</span><b>{{ a.manufacturer || '—' }} {{ a.modelName || '' }}</b></div>
              <div><span>Firmware</span><b class="mono">{{ a.softwareVersion || '—' }}</b></div>
              <div><span>Estado</span><b><span class="acs-dot" [class.on]="isOnline(a)"></span>{{ a.status || '—' }}</b></div>
              <div><span>WiFi</span><b>{{ acsParam('.SSID') }}</b></div>
            </div>
            <div class="chips" style="margin-top:10px">
              <button class="chip" (click)="acsRefresh()">🔄 Refrescar</button>
              <button class="chip" (click)="acsReboot()">♻ Reiniciar</button>
              <button class="chip acs-now" (click)="acsConnReq()" title="Contactar al router ahora (no funciona tras CGNAT)">⚡ Aplicar ahora</button>
            </div>
            <div class="ir"><input class="isel" style="flex:1" [(ngModel)]="wifiSsid" placeholder="Nuevo nombre WiFi"><button class="btn2 xs" (click)="acsSetWifiNombre()">Cambiar</button></div>
            <div class="ir"><input class="isel" style="flex:1" type="password" [(ngModel)]="wifiPass" placeholder="Nueva clave WiFi (mín. 8)"><button class="btn2 xs" (click)="acsSetWifiClave()">Cambiar</button></div>
            <div class="note">Las órdenes se aplican en el próximo contacto del router (CGNAT: ~10–15 min).</div>
            @if (acsTareas().length) {
              <div class="sub">Tareas ACS</div>
              <div class="tl">
                @for (k of acsTareas(); track k.id) { <div class="it"><span class="tm">{{ k.taskType }}</span><span class="tx"><b>{{ k.status }}</b>{{ k.errorMessage ? ' → ' + k.errorMessage : '' }}</span></div> }
              </div>
            }
          } @else {
            <div class="note">{{ acsMsg() || 'Este cliente aún no tiene router registrado en el ACS.' }}</div>
          }
          </div>
        </div>

        <div class="fcard">
          <div class="ft">🕒 Historial del ticket</div>
          <div class="fb">
            @if (t.idTic) {
              <div class="ir"><input class="isel" style="flex:1" [(ngModel)]="notaTxt" placeholder="Nota / observación…"><button class="btn2 xs" [disabled]="!notaTxt.trim()" (click)="agregarNota(t)">Agregar</button></div>
            }
            @if (ticSaltos().length) {
              <div class="tl">
                @for (l of ticSaltos(); track $index) { <div class="it"><span class="tm">{{ l.fecha }}</span><span class="tx"><b>{{ accionTic(l) }}</b> · {{ l.usu }}{{ l.observacion ? ' — ' + l.observacion : '' }}</span></div> }
              </div>
            } @else { <div class="note">Sin movimientos en el ticket.</div> }
          </div>
        </div>
        </div>

      </div>

      @if (showOrder()) {
        <div class="overlay on" (click)="showOrder.set(false)"></div>
        <div style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:60" (click)="showOrder.set(false)">
          <div class="panel" style="width:min(560px,94vw)" (click)="$event.stopPropagation()">
            <div class="ph">🔧 Crear Orden Técnica <span class="mini">datos del cliente ya van cargados</span></div>
            <div class="pb" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="fld"><label>Prioridad</label>
                <select class="inp" [(ngModel)]="of.prioridad"><option>Alta</option><option>Media</option><option>Baja</option></select></div>
              <div class="fld"><label>Tipo de visita</label>
                <select class="inp" [(ngModel)]="of.tipo_visita"><option>Reparación</option><option>Instalación</option><option>Revisión</option><option>Cambio de equipo</option></select></div>
              <div class="fld"><label>Técnico asignado</label><input class="inp" [(ngModel)]="of.tecnico" placeholder="(opcional)"></div>
              <div class="fld"><label>Fecha tentativa</label><input class="inp" type="date" [(ngModel)]="of.fecha"></div>
              <div class="fld" style="grid-column:1/-1"><label>Observación adicional</label><textarea class="inp" rows="2" style="resize:vertical" [(ngModel)]="of.observacion"></textarea></div>
            </div>
            <div class="ph" style="border-top:1px solid var(--border);border-bottom:none;justify-content:flex-end;gap:8px">
              <button class="btn ghost" (click)="showOrder.set(false)">Cancelar</button>
              <button class="btn" (click)="createOrder()">Crear orden</button>
            </div>
          </div>
        </div>
      }
    }

  `,
  styles: [`
    .back { color:#7c0061; cursor:pointer; display:inline-block; margin-bottom:10px; font-weight:600; }
    .fld { display:flex; flex-direction:column; gap:3px; } .fld label { font-size:11px; color:var(--muted); font-weight:600; }
    .chips { display:flex; flex-wrap:wrap; gap:7px; }
    .chip { cursor:pointer; height:30px; border:1px solid #ece8f1; background:#fff; border-radius:8px; padding:0 11px; font-size:12.5px; display:inline-flex; align-items:center; }
    .chip:hover { background:#faf8fc; }
    .acs-dot { display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--muted);margin-right:6px;vertical-align:middle; }
    .acs-dot.on { background:#16a34a; box-shadow:0 0 0 3px rgba(22,163,74,.22); }
    .acs-now { border:1px solid #d97706 !important; color:#b45309; font-weight:600; }
    .fbox,.fcard { background:#fff; border:1px solid #ece8f1; border-radius:16px; box-shadow:0 1px 2px rgba(26,21,38,.04),0 6px 24px rgba(26,21,38,.05); }
    .fbox { margin-bottom:14px; }
    .fhd { display:flex; align-items:center; gap:12px; padding:16px; }
    .fav { width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#7c0061,#a4008a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px; }
    .fwho .nm { font-weight:800; font-size:16px; }
    .fwho .cn { color:var(--muted); font-size:12.5px; }
    .fst { margin-left:auto; }
    .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; padding:0 16px 14px; }
    @media(max-width:900px){ .kpis{ grid-template-columns:repeat(2,1fr) } }
    .kpi { background:#faf9fc; border:1px solid #ece8f1; border-radius:12px; padding:10px 12px; }
    .kpi .k { font-size:11px; color:var(--muted); font-weight:600; }
    .kpi .v { font-size:15px; font-weight:800; margin-top:3px; } .kpi .v.s { font-size:12.5px; font-weight:700; }
    .cbar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:12px 16px; margin:0 16px 16px; background:#faf9fc; border:1px solid #ece8f1; border-radius:12px; }
    .btn2 { height:34px; border-radius:9px; border:1px solid #ece8f1; background:#fff; padding:0 13px; font-weight:600; font-size:13px; cursor:pointer; display:inline-flex; align-items:center; gap:6px; }
    .btn2.xs { height:30px; padding:0 11px; font-size:12.5px; }
    .btn2.primary { background:#7c0061; color:#fff; border-color:#7c0061; }
    .btn2.wa { background:#25D366; color:#fff; border-color:#25D366; }
    .btn2.ok { background:#16a34a; color:#fff; border-color:#16a34a; }
    .btn2:disabled { opacity:.5; cursor:not-allowed; }
    .isel { height:34px; border:1px solid #ece8f1; border-radius:9px; background:#fff; padding:0 10px; font-size:13px; outline:none; }
    .isel.ta { height:auto; padding:8px 10px; width:100%; margin-top:8px; resize:vertical; font-family:inherit; }
    .ir { display:flex; gap:8px; align-items:center; margin-top:8px; }
    .cinfo { display:grid; grid-template-columns:repeat(4,1fr); gap:8px 14px; padding:0 16px 12px; }
    @media(max-width:900px){ .cinfo{ grid-template-columns:repeat(2,1fr) } }
    .cinfo > div { display:flex; flex-direction:column; }
    .cinfo span { font-size:11px; color:var(--muted); font-weight:600; }
    .cinfo b { font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .cpill { font-size:11px; font-weight:700; padding:4px 10px; border-radius:999px; background:#f7f0f6; color:#7c0061; }
    .fgrid { display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start; }
    .fgrid2 { display:grid; grid-template-columns:1.35fr 1fr; gap:14px; align-items:start; }
    @media(max-width:900px){ .fgrid2{ grid-template-columns:1fr } }
    .fcol { display:flex; flex-direction:column; gap:14px; }
    @media(max-width:900px){ .fgrid{ grid-template-columns:1fr } }
    .fcard.full { grid-column:1/-1; }
    .ft { padding:12px 15px; font-weight:700; font-size:13.5px; background:#faf9fc; border-bottom:1px solid #ece8f1; border-radius:16px 16px 0 0; }
    .fb { padding:14px; }
    .sub { font-size:11px; font-weight:700; color:var(--muted); margin:14px 0 7px; text-transform:uppercase; letter-spacing:.4px; }
    .rowbtns { display:flex; gap:7px; flex-wrap:wrap; margin-top:9px; }
    .res { margin-top:9px; font-size:12.5px; color:#2563eb; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; padding:7px 10px; }
    .note { color:var(--muted); font-size:12px; margin-top:8px; }
    .rmeta { display:grid; grid-template-columns:1fr 1fr; gap:8px 14px; }
    .rmeta > div { display:flex; flex-direction:column; }
    .rmeta span { font-size:11px; color:var(--muted); font-weight:600; }
    .rmeta b { font-size:13px; }
    .tl { display:flex; flex-direction:column; margin-top:6px; border:1px solid #ece8f1; border-radius:10px; overflow:hidden; max-height:280px; overflow-y:auto; }
    .tl .it { display:flex; gap:10px; padding:8px 11px; border-bottom:1px solid #f1eef5; font-size:12.5px; }
    .tl .it:last-child { border-bottom:none; }
    .tl .tm { color:var(--muted); font-family:'Consolas',monospace; white-space:nowrap; font-size:11.5px; }
    .tl .tx { flex:1; }
  `],
})
export class Soporte {
  private api = inject(NocApi);
  private notify = inject(NocNotify);
  private readonly usuario = 'Wilson S.';

  view = signal<'bandeja' | 'ticket'>('bandeja');
  ticSaltos = signal<any[]>([]);
  cli = signal<any>({});
  ticAcc = signal<any[]>([]);
  estadosCat = signal<{ id: any; nombre: string }[]>([]);
  nuevoEstado: number | null = null;
  notaTxt = '';
  ticket = signal<any | null>(null);
  diag = '';
  lastResult = signal('');
  showOrder = signal(false);
  acs = signal<any | null>(null);
  acsWrite = signal<boolean | null>(null);
  acsMsg = signal('');
  acsTareas = signal<any[]>([]);
  acsParams = signal<any[]>([]);
  wifiSsid = '';
  wifiPass = '';
  of: any = { prioridad: 'Alta', tipo_visita: 'Reparación', tecnico: '', fecha: '', observacion: '' };

  diagBtns = [
    { l: 'Sin internet', t: 'Cliente reporta que no tiene internet. Se valida estado de ONU y potencia.' },
    { l: 'Internet lento', t: 'Cliente reporta internet lento. Se revisa consumo y potencia.' },
    { l: 'Intermitente', t: 'Servicio intermitente. Se revisa historial de caídas y potencia.' },
    { l: 'LOS roja', t: 'Cliente indica luz LOS roja en la ONU. Posible causa: corte de fibra, conector dañado o potencia baja. Acción: se valida con cliente estado de luces y reinicio básico. Resultado: requiere visita técnica.' },
    { l: 'ONU apagada', t: 'ONU apagada / sin luces. Se pide al cliente verificar energía y conexión.' },
    { l: 'Router apagado', t: 'Router del cliente apagado. Se pide verificar energía del router.' },
    { l: 'Cambio clave WiFi', t: 'Cliente solicita cambio de clave WiFi.' },
    { l: 'Cliente no responde', t: 'No se logra contactar al cliente.' },
    { l: 'Problema masivo', t: 'Posible problema masivo en el sector/nodo.' },
    { l: 'Requiere visita', t: 'Requiere visita técnica.' },
  ];

  /** Abre la ficha tecnica (OLT + Router) de un ticket de la bandeja, por su contrato. Resuelve la
   *  ONU del contrato y arma una ficha de solo-consulta (sin crear ticket NOC). */
  abrirPorContrato(r: any) {
    const c = String(r?.con ?? '').trim();
    if (!c) return;
    const idTic = r?.id_tic_ticket ?? null;
    this.ticSaltos.set([]); this.ticAcc.set([]); this.nuevoEstado = null; this.notaTxt = ''; this.cli.set({});
    const idc = Number(c); if (!isNaN(idc)) this.api.supContrato(idc).subscribe({ next: (d: any) => this.cli.set(d || {}), error: () => {} });
    if (!this.estadosCat().length) this.api.supInboxCatalogos().subscribe({ next: (cc: any) => this.estadosCat.set(this.mapEstados(cc?.estados)), error: () => {} });
    if (idTic != null) this.api.supInboxTimeline(idTic).subscribe({
      next: (d: any) => { this.ticSaltos.set(d?.log || []); this.ticAcc.set(d?.acciones || []); }, error: () => {},
    });
    this.api.supSearch(c).subscribe((rs: any[]) => {
      const list = rs || [];
      const o = list.find((x) => this.contrato(x.client_name) === c) || list[0];
      const t: any = {
        id: 0, idTic, contrato: c, movil: r?.movil ?? null, estado: r?.requerimiento || 'Bandeja',
        cliente: o ? this.clientOnly(o.client_name) : ('Contrato ' + c),
        client_ip: o?.client_ip, olt_name: o?.olt_name,
        pon: o ? ((o.slot ?? '') + '/' + (o.port ?? '')) : '—', onu_num: o?.onu_id,
        phase_state: o?.phase_state, rx_dbm: o?.onu_rx_dbm, distance_m: o?.distance_m,
        out_rate_bps: o?.onu_out_rate_bps, in_rate_bps: o?.onu_in_rate_bps,
      };
      this.ticket.set(t); this.diag = ''; this.lastResult.set(''); this.loadAcs(c); this.view.set('ticket');
    });
  }

  waCliente() {
    const t = this.ticket();
    let p = String(t?.movil ?? '').replace(/\D/g, '');
    if (!p) return;
    if (p.length === 10 && p.startsWith('0')) p = '593' + p.substring(1);
    window.open('https://wa.me/' + p, '_blank');
  }

  /** Primer valor presente del contrato (kxv_con_contrato) entre varias columnas candidatas. */
  cf(...keys: string[]): string {
    const c = this.cli() || {};
    for (const k of keys) { const v = c[k]; if (v != null && String(v).trim() !== '') return String(v); }
    return '';
  }

  accionTic(l: any): string {
    const id = l.id_tic_accion_fk ?? l.id_tic_accion;
    const a = this.ticAcc().find((x) => (x.id_tic_accion ?? x.id) === id);
    return (a && (a.accion || a.nombre || a.descripcion)) || ('acción ' + (id ?? '—'));
  }

  private mapEstados(arr: any[]): { id: any; nombre: string }[] {
    return (arr || [])
      .map((r) => ({ id: r.id_tic_estado ?? r.id, nombre: String(r.estado ?? r.nombre ?? r.descripcion ?? (r.id_tic_estado ?? r.id)) }))
      .sort((a, b) => a.nombre.localeCompare(b.nombre));
  }

  private recargarSaltos(idTic: any) {
    if (idTic == null) return;
    this.api.supInboxTimeline(idTic).subscribe({ next: (d: any) => { this.ticSaltos.set(d?.log || []); this.ticAcc.set(d?.acciones || []); }, error: () => {} });
  }

  tomarTicket(t: any) {
    if (!t?.idTic) return;
    this.api.supTomar(t.idTic).subscribe({
      next: () => { this.notify.ok('Ticket tomado.'); this.recargarSaltos(t.idTic); },
      error: (e: any) => this.notify.error(e?.error?.mensaje || 'No se pudo tomar el ticket.'),
    });
  }

  cambiarEstado(t: any) {
    if (!t?.idTic || this.nuevoEstado == null) return;
    this.api.supEstado(t.idTic, this.nuevoEstado, this.notaTxt.trim() || undefined).subscribe({
      next: () => { this.notify.ok('Estado actualizado.'); this.notaTxt = ''; this.nuevoEstado = null; this.recargarSaltos(t.idTic); },
      error: (e: any) => this.notify.error(e?.error?.mensaje || 'No se pudo cambiar el estado.'),
    });
  }

  agregarNota(t: any) {
    const n = this.notaTxt.trim();
    if (!t?.idTic || !n) return;
    this.api.supNota(t.idTic, n).subscribe({
      next: () => { this.notify.ok('Nota agregada.'); this.notaTxt = ''; this.recargarSaltos(t.idTic); },
      error: (e: any) => this.notify.error(e?.error?.mensaje || 'No se pudo agregar la nota.'),
    });
  }
  private reload() { const t = this.ticket(); if (t && t.id) this.api.supTicket(t.id).subscribe((x) => this.ticket.set(x)); }

  addDiag(text: string) { this.diag = (this.diag ? this.diag + '\n' : '') + text; }
  saveDiag() { const t = this.ticket(); if (t && t.id) this.api.supUpdateTicket(t.id, { diagnostico: this.diag, usuario: this.usuario }).subscribe(() => this.reload()); }
  copyDiag() { navigator.clipboard?.writeText(this.diag || ''); this.lastResult.set('Diagnóstico copiado.'); }

  runAction(action: string) {
    const t = this.ticket(); if (!t) return;
    if (!t.id) { this.lastResult.set('Ficha abierta desde la bandeja: el estado y la potencia ya se ven arriba; las consultas de ticket se habilitan desde Tickets.'); return; }
    this.lastResult.set('Consultando…');
    this.api.supAction(t.id, action, this.usuario).subscribe((r) => { this.lastResult.set(r.accion + ' → ' + r.resultado); this.reload(); });
  }
  copyIp() { const t = this.ticket(); if (t?.client_ip) { navigator.clipboard?.writeText(t.client_ip); this.lastResult.set('IP copiada: ' + t.client_ip); if (t.id) this.api.supLog(t.id, 'Copió IP', t.client_ip, this.usuario).subscribe(() => this.reload()); } }
  openRouter() { const t = this.ticket(); if (t?.client_ip) { window.open('http://' + t.client_ip, '_blank'); this.api.supLog(t.id, 'Abrió router', 'http://' + t.client_ip, this.usuario).subscribe(() => this.reload()); } }

  setEstado(estado: string, resultado: string) {
    const t = this.ticket(); if (!t) return;
    if (!t.id) { this.notify.error('Ficha desde bandeja: abre/crea el ticket para cambiar su estado.'); return; }
    this.api.supUpdateTicket(t.id, { estado, resultado, usuario: this.usuario }).subscribe(() => this.reload());
  }

  createOrder() {
    const t = this.ticket(); if (!t) return;
    if (!t.id) { this.notify.error('Ficha desde bandeja: abre/crea el ticket para generar la orden.'); return; }
    this.api.supCreateOrder(t.id, { ...this.of, usuario: this.usuario }).subscribe({
      next: (r: any) => {
        this.showOrder.set(false);
        this.lastResult.set('✅ Orden técnica ' + r.numero + ' creada.');
        this.reload();
        this.notify.ok('Orden técnica ' + r.numero + ' creada.');
      },
      error: (e: any) => this.notify.error(e?.message || 'No se pudo crear la orden técnica.'),
    });
  }

  // ---- ACS (router del cliente por TR-069) ----
  loadAcs(contrato: string | null) {
    this.acs.set(null); this.acsTareas.set([]); this.acsParams.set([]); this.acsMsg.set('');
    if (!contrato) { this.acsMsg.set('El ticket no tiene contrato para ubicar el router.'); return; }
    this.api.acsConfig().subscribe({ next: (c: any) => this.acsWrite.set(!!c?.write_enabled), error: () => {} });
    this.api.acsStatus(contrato).subscribe({
      next: (d) => { this.acs.set(d); this.api.acsTareas(contrato).subscribe((k) => this.acsTareas.set(k)); this.api.acsParametros(contrato).subscribe((ps) => this.acsParams.set(ps || [])); },
      error: (e) => this.acsMsg.set(e?.error?.mensaje || 'Este cliente aún no tiene router registrado en el ACS.'),
    });
  }
  private acsDo(obs: any, okMsg: string) {
    const t = this.ticket(); if (!t) return;
    this.acsMsg.set('Encolando…');
    obs.subscribe({
      next: () => { this.acsMsg.set('✅ ' + okMsg); this.loadAcs(t.contrato); this.notify.ok(okMsg); },
      error: (e: any) => { const m = e?.error?.mensaje || 'No se pudo encolar la acción.'; this.acsMsg.set('⚠ ' + m); this.notify.error(m); },
    });
  }
  acsParam(suffix: string): string { const p = this.acsParams().find((x) => (x.parameterName || '').endsWith(suffix)); return (p && p.parameterValue) || '—'; }
  acsRefresh() { const t = this.ticket(); if (t) this.acsDo(this.api.acsRefresh(t.contrato), 'Refresco de datos encolado.'); }
  acsReboot() { const t = this.ticket(); if (!t) return; if (!confirm('¿Reiniciar el router del cliente?')) return; this.acsDo(this.api.acsReboot(t.contrato), 'Reinicio encolado.'); }
  acsSetWifiNombre() {
    const t = this.ticket(); if (!t) return;
    if (!this.wifiSsid.trim()) { this.acsMsg.set('Escribe el nuevo nombre WiFi.'); return; }
    this.acsDo(this.api.acsWifiNombre(t.contrato, this.wifiSsid.trim()), 'Cambio de nombre WiFi encolado.'); this.wifiSsid = '';
  }
  acsSetWifiClave() {
    const t = this.ticket(); if (!t) return;
    if (this.wifiPass.length < 8) { this.acsMsg.set('La clave WiFi debe tener al menos 8 caracteres.'); return; }
    this.acsDo(this.api.acsWifiClave(t.contrato, this.wifiPass), 'Cambio de clave WiFi encolado.'); this.wifiPass = '';
  }

  acsConnReq() {
    const t = this.ticket(); if (!t) return;
    this.acsMsg.set('Contactando al router…');
    this.api.acsConnReq(t.contrato).subscribe({
      next: (r: any) => {
        const ok = !!(r && r.contacted);
        const m = ok ? 'Router contactado: aplicará los cambios al instante.'
                     : 'El router no respondió (CGNAT/NAT). Se aplicará en el próximo contacto.';
        this.acsMsg.set((ok ? '✅ ' : '⌛ ') + m);
        if (ok) this.notify.ok(m);
        this.loadAcs(t.contrato);
      },
      error: (e: any) => { const m = e?.error?.mensaje || 'No se pudo contactar al router.'; this.acsMsg.set('⚠ ' + m); this.notify.error(m); },
    });
  }
  isOnline(a: any): boolean { return String(a?.status || '').toLowerCase() === 'online'; }
  activarEscritura() {
    this.api.acsSaveConfig({ write_enabled: true }).subscribe({
      next: () => { this.acsWrite.set(true); this.acsMsg.set('✅ Escritura ACS activada.'); this.notify.ok('Escritura ACS activada. Ya puedes aplicar cambios.'); },
      error: (e: any) => this.notify.error(e?.error?.mensaje || 'No se pudo activar la escritura ACS.'),
    });
  }

  // ---- presentación ----
  stBadge(s: string): string {
    const p = (s || '').toLowerCase();
    if (p === 'working') return '<span class="badge b-up">ONLINE</span>';
    if (p === 'los') return '<span class="badge b-down">LOS</span>';
    return '<span class="badge b-maint">OFFLINE</span>';
  }
  rxColor(v: number | null): string {
    if (v == null) return 'var(--muted)';
    if (v <= -28) return 'var(--red)'; if (v <= -25) return 'var(--amber)'; return 'var(--green)';
  }
  rate(bps: number | null): string {
    if (bps == null) return '—';
    const b = bps * 8;
    if (b >= 1e6) return (b / 1e6).toFixed(1) + ' Mbps';
    if (b >= 1e3) return (b / 1e3).toFixed(0) + ' Kbps';
    return b + ' bps';
  }
  contrato(name: string | null): string { if (!name) return ''; const m = name.match(/^\s*(\d+)\s*[-_]/); return m ? m[1] : ''; }
  clientOnly(name: string | null): string {
    if (!name) return '(sin nombre)';
    let n = name.trim().replace(/^\s*\d+\s*[-_]+\s*/, '').replace(/[-_]+\s*\d{1,3}(\.\d{1,3}){3}\s*$/, '').replace(/[-_\s]+$/, '').trim();
    return n || name;
  }
}
