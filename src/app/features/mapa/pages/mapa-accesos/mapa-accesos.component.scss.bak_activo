:host { display: block; --pri: #7c0061; --ink: #1a1526; --mut: #8a8296; --line: #e6eaf0; }

.acc { max-width: 1180px; margin: 0 auto; padding: 16px 18px 60px; color: var(--ink); }

.acc-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.acc-head h2 { margin: 0; font-size: 18px; }
.acc-tools { margin-left: auto; display: flex; gap: 6px; }

.inp {
  border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px;
  font-size: 13px; color: var(--ink); background: #fff; min-width: 0;
}
.inp.full { width: 100%; }
.inp.hora { width: 7.5rem; }
textarea.inp { min-height: 3.2rem; resize: vertical; font-family: inherit; }

.btn {
  border: 1px solid var(--line); background: #fff; border-radius: 8px;
  padding: 6px 12px; font-size: 13px; font-weight: 600; color: #475569; cursor: pointer;
}
.btn:hover { background: #f5f7fa; color: var(--ink); }
.btn.pri { background: var(--pri); border-color: var(--pri); color: #fff; }
.btn.pri:hover { filter: brightness(1.08); }
.btn.pri[disabled] { opacity: .6; cursor: default; }
.btn.xs { padding: 3px 8px; font-size: 11.5px; }
.btn.del:hover { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }

.acc-msg { padding: 12px 2px; font-size: 13px; color: var(--mut); }
.acc-msg.error { color: #b91c1c; }
.acc-msg.ok { color: #15803d; }

.acc-tab { width: 100%; border-collapse: collapse; font-size: 13px; }
.acc-tab th {
  text-align: left; color: var(--mut); font-weight: 700; font-size: 10.5px;
  text-transform: uppercase; letter-spacing: .3px; padding: 7px 8px;
  border-bottom: 1px solid var(--line); white-space: nowrap;
}
.acc-tab td { padding: 8px; border-bottom: 1px solid #f2f4f8; vertical-align: top; }
.acc-tab .num { text-align: right; width: 4rem; }
.acc-tab .mono { font-variant-numeric: tabular-nums; white-space: nowrap; }
.acc-tab .acciones { white-space: nowrap; text-align: right; }
.acc-tab .acciones .btn { margin-left: 4px; }

.tenue { color: var(--mut); font-size: 12px; }

.pill {
  margin-left: 8px; padding: 1px 8px; border-radius: 999px;
  background: #f1f5f9; color: #64748b; font-size: 11px; font-weight: 700;
}
.pill.on { background: #dcfce7; color: #15803d; }

.aviso {
  margin-left: 6px; padding: 1px 8px; border-radius: 999px;
  background: #fff4e5; color: #b45309; font-size: 11px; font-weight: 700;
}

/* ---- editor ---- */
.acc-ov {
  position: fixed; inset: 0; background: rgba(15, 23, 42, .38);
  display: flex; align-items: center; justify-content: center; z-index: 60;
}
.acc-md {
  width: min(44rem, 94vw); max-height: 88vh; background: #fff;
  border-radius: 14px; box-shadow: 0 24px 60px rgba(15, 23, 42, .28);
  display: grid; grid-template-rows: auto minmax(0, 1fr) auto; overflow: hidden;
}
.acc-md-head {
  display: flex; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--line);
}
.acc-md-body { padding: 12px 14px; overflow: auto; }
.acc-md-foot {
  display: flex; justify-content: flex-end; gap: 6px;
  padding: 10px 14px; border-top: 1px solid var(--line); background: #fbfcfe;
}

.acc-md-body label {
  display: block; margin: 10px 0 4px; font-size: 11px; font-weight: 700;
  color: var(--mut); text-transform: uppercase; letter-spacing: .3px;
}

.g2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 10px; }

.x {
  margin-left: auto; border: none; background: transparent; font-size: 20px;
  line-height: 1; color: var(--mut); cursor: pointer; padding: 0 4px;
}
.x:hover { color: var(--ink); }
.x.sm { font-size: 15px; margin: 0; }

.hor-head {
  display: flex; align-items: baseline; gap: 10px;
  margin: 16px 0 8px; padding-top: 12px; border-top: 1px solid var(--line);
}

.dia { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 8px; padding: 4px 0; }
.dia-n { font-size: 12px; font-weight: 800; color: #475569; padding-top: 7px; }
.dia-tramos { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.tramo { display: flex; align-items: center; gap: 4px; }
.tramo .a { font-size: 12px; color: var(--mut); }
