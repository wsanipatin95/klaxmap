.properties-shell {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.properties-shell.open {
  pointer-events: auto;
}

.properties-overlay {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.38);
  z-index: 1;
}

/* Modal centrado. Antes era un cajon pegado al borde derecho; con tres pestanas
   adentro el ancho de cajon quedaba corto para la tabla de clientes. */
.properties-drawer {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(54rem, 94vw);
  max-height: min(88vh, 46rem);
  height: auto;
  background: #ffffff;
  border: 1px solid #d8dee6;
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
  transform: translate(-50%, -48%) scale(0.98);
  opacity: 0;
  transition: transform 0.18s ease, opacity 0.18s ease;
  z-index: 2;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;
  color: #334155;
}

.properties-drawer.open {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

/* ---- pestanas ---- */
.panel-tabs {
  display: flex;
  gap: 2px;
  padding: 0 14px;
  border-bottom: 1px solid #e6eaf0;
  background: #fbfcfe;
}

.panel-tab {
  appearance: none;
  border: none;
  background: transparent;
  padding: 10px 14px;
  font-size: 13px;
  font-weight: 700;
  color: #7c8798;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.panel-tab:hover { color: #334155; }

.panel-tab.active {
  color: #7c0061;
  border-bottom-color: #7c0061;
}

.tab-count {
  min-width: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: #ece8f1;
  color: #6b6478;
  font-size: 11px;
  line-height: 17px;
  text-align: center;
}

.panel-tab.active .tab-count { background: #7c0061; color: #fff; }

/* ---- soporte ---- */
.sop-head {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.sop-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  padding: 5px 10px;
  border: 1px solid #e6eaf0;
  border-radius: 999px;
  background: #fbfcfe;
  font-size: 12.5px;
}

.sop-chip .sop-k { color: #8a93a3; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; }
.sop-chip.libre b { color: #15803d; }

.sop-refresh {
  margin-left: auto;
  appearance: none;
  border: 1px solid #e6eaf0;
  background: #fff;
  border-radius: 8px;
  width: 30px;
  height: 30px;
  font-size: 15px;
  color: #64748b;
  cursor: pointer;
}

.sop-refresh:hover { background: #f5f7fa; color: #334155; }

.sop-msg {
  padding: 14px 2px;
  font-size: 13px;
  color: #8a93a3;
}

.sop-msg.error { color: #b91c1c; }

.sop-tab {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}

.sop-tab th {
  text-align: left;
  color: #8a93a3;
  font-weight: 700;
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: .3px;
  padding: 6px 8px;
  border-bottom: 1px solid #e6eaf0;
  white-space: nowrap;
}

.sop-tab td {
  padding: 6px 8px;
  border-bottom: 1px solid #f2f4f8;
}

.sop-tab .pto { width: 42px; font-weight: 700; color: #475569; }
.sop-tab .doc { white-space: nowrap; color: #64748b; }
.sop-tab .cli { max-width: 18rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.est {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 11.5px;
  font-weight: 600;
}

.est.ok { background: #dcfce7; color: #15803d; }

.panel-save-blocker {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(2px);
}

.panel-save-card {
  width: min(22rem, calc(100% - 2rem));
  padding: 1rem 1.05rem;
  border-radius: 0.9rem;
  border: 1px solid #e9a8cb;
  background: #ffffff;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
}

.panel-save-title {
  font-size: 0.82rem;
  font-weight: 800;
  color: #7b0061;
}

.panel-save-text {
  margin-top: 0.25rem;
  font-size: 0.73rem;
  line-height: 1.4;
  color: #475569;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 0.7rem 0.8rem;
  border-bottom: 1px solid #e2e8f0;
  background: #ffffff;
}

.panel-title-wrap {
  min-width: 0;
  flex: 1 1 auto;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  min-width: 0;
}

.panel-title-wrap h3 {
  margin: 0;
  font-size: 0.98rem;
  color: #334155;
  line-height: 1.2;
  word-break: break-word;
}

.panel-title-wrap small {
  display: block;
  margin-top: 0.18rem;
  color: #64748b;
  font-size: 0.74rem;
}

.dirty-badge {
  display: inline-flex;
  align-items: center;
  min-height: 1.5rem;
  padding: 0 0.45rem;
  border-radius: 999px;
  border: 1px solid #f3c7df;
  background: #fdf4f9;
  color: #7b0061;
  font-size: 0.66rem;
  font-weight: 800;
  flex: 0 0 auto;
}

.panel-actions {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex: 0 0 auto;
}

.close-btn,
.delete-btn {
  min-height: 2rem;
  border-radius: 0.65rem;
  font-size: 0.76rem;
  font-weight: 700;
  cursor: pointer;
}

.close-btn {
  width: 2rem;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #475569;
  line-height: 1;
}

.close-btn:hover:not(:disabled) {
  background: #f8fafc;
}

.delete-btn {
  border: 1px solid #ef4444;
  background: #ef4444;
  color: #ffffff;
  padding: 0 0.75rem;
}

.delete-btn:hover:not(:disabled) {
  background: #dc2626;
  border-color: #dc2626;
}

.close-btn:disabled,
.delete-btn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.panel-status {
  margin: 0.8rem 0.8rem 0;
  padding: 0.72rem 0.8rem;
  border-radius: 0.72rem;
  font-size: 0.74rem;
  line-height: 1.4;
  font-weight: 700;
}

.panel-status.is-success {
  border: 1px solid #d8b4e2;
  background: #fdf4f9;
  color: #7b0061;
}

.panel-status.is-error {
  border: 1px solid #fecdd3;
  background: #fff1f2;
  color: #b42318;
}

.panel-tabs {
  display: flex;
  gap: 0.5rem;
  padding: 0.85rem 0.9rem 0;
  background: #ffffff;
}

.panel-tab-btn {
  min-height: 2.35rem;
  padding: 0 0.95rem;
  border-radius: 0.8rem;
  border: 1px solid #d8dee6;
  background: #ffffff;
  color: #475569;
  font-size: 0.78rem;
  font-weight: 800;
  cursor: pointer;
}

.panel-tab-btn:hover:not(.active) {
  background: #f8fafc;
}

.panel-tab-btn.active {
  background: #fdf4f9;
  border-color: #f3c7df;
  color: #7b0061;
}

.panel-body {
  min-height: 0;
  overflow: hidden;
  padding: 0.9rem;
}

.panel-view {
  height: 100%;
  min-height: 0;
}

.panel-view-scroll {
  height: 100%;
  min-height: 0;
  overflow: auto;
  display: grid;
  gap: 1rem;
  padding-right: 0.1rem;
}

.panel-section {
  display: grid;
  gap: 0.8rem;
}

.section-head {
  display: grid;
  gap: 0.18rem;
}

.section-head h4 {
  margin: 0;
  font-size: 0.9rem;
  color: #0f172a;
}

.section-head p {
  margin: 0;
  color: #64748b;
  font-size: 0.78rem;
}

.empty-state {
  padding: 1rem;
  color: #64748b;
  background: #ffffff;
  font-size: 0.78rem;
}

/* === KLAXMAP RESPONSIVE HARDENING: BEGIN === */
@media (max-width: 860px) {
  .properties-drawer {
    width: min(34rem, 100vw);
    max-width: 100vw;
  }

  .panel-header {
    padding: 0.65rem 0.72rem;
  }

  .panel-tabs {
    overflow-x: auto;
    padding: 0.7rem 0.72rem 0;
    -webkit-overflow-scrolling: touch;
  }

  .panel-tab-btn {
    flex: 0 0 auto;
    min-height: 2.45rem;
  }

  .panel-body {
    padding: 0.72rem;
  }
}

@media (max-width: 520px) {
  .properties-drawer {
    width: 100vw;
    border-left: 0;
  }

  .panel-header {
    gap: 0.55rem;
  }

  .title-row {
    flex-wrap: wrap;
  }

  .panel-title-wrap h3 {
    font-size: 0.9rem;
  }

  .close-btn,
  .delete-btn {
    min-height: 2.25rem;
  }

  .panel-tabs {
    gap: 0.38rem;
  }

  .panel-tab-btn {
    min-height: 2.35rem;
    padding: 0 0.75rem;
    font-size: 0.74rem;
  }
}
/* === KLAXMAP RESPONSIVE HARDENING: END === */


/* ---- materiales ---- */
.mat-sub {
  margin: 10px 0 6px;
  font-size: 10.5px;
  font-weight: 800;
  color: #8a93a3;
  text-transform: uppercase;
  letter-spacing: .3px;
}

.mat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.mat-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  padding: 4px 10px;
  border: 1px solid #e6eaf0;
  border-radius: 999px;
  background: #fbfcfe;
  font-size: 12.5px;
  color: #475569;
}

.mat-chip b { color: #7c0061; }

.mat-extra {
  margin-left: 6px;
  padding: 0 6px;
  border-radius: 999px;
  background: #fff4e5;
  color: #b45309;
  font-size: 10.5px;
  font-weight: 700;
}
