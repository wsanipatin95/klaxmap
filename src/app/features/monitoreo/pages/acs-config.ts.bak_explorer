import { Component, inject, signal, OnInit, OnDestroy, HostListener } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { NocApi } from '../services/noc-api';
import { NocNotify } from '../services/noc-notify';

/** ACS (TR-069): pestañas Panel principal / Configuración. Click en un router abre modal con todo + acciones. */
@Component({
  selector: 'app-acs-config',
  standalone: true,
  imports: [FormsModule],
  template: `
    <div class="acs">
      <div class="hd">
        <div class="ttl">📊 ACS <span class="tr">TR-069</span></div>
        <div class="sub">Autoconfiguración y gestión remota de routers</div>
      </div>

      <div class="tabs">
        <button class="tab" [class.act]="tab() === 'panel'" (click)="tab.set('panel')">Panel principal</button>
        <button class="tab" [class.act]="tab() === 'config'" (click)="tab.set('config')">Configuración</button>
      </div>

      @if (tab() === 'panel') {
        <div class="kpis">
          <div class="kpi"><div class="kn">{{ devices().length }}</div><div class="kl">Routers</div></div>
          <div class="kpi ok"><div class="kn">{{ nOnline() }}</div><div class="kl">Online</div></div>
          <div class="kpi warn"><div class="kn">{{ nSinContrato() }}</div><div class="kl">Sin contrato</div></div>
          <div class="kpi"><div class="kn">{{ nConnReq() }}</div><div class="kl">Con ConnReq</div></div>
        </div>

        <div class="card">
          <div class="ch bar">
            <span>Routers registrados <span class="cnt">{{ filtered().length }}</span></span>
            <input class="search" [(ngModel)]="q" placeholder="Buscar serie, contrato, marca, IP, MAC…">
            <span class="live" title="La lista se actualiza sola cada 8 s">● En vivo</span>
          </div>

          @if (filtered().length) {
            <div class="tw">
              <table>
                <thead><tr>
                  <th>Estado</th><th>Equipo</th><th>Serie</th><th>Contrato</th>
                  <th>IP cliente</th><th>IP KLAX</th><th>Firmware</th><th>Modelo</th><th>WiFi</th><th>Último Inform</th><th>ConnReq</th><th></th>
                </tr></thead>
                <tbody>
                  @for (d of filtered(); track d.id) {
                    <tr class="drow click" (click)="openModal(d)">
                      <td><span class="st" [class.on]="dOnline(d)"></span><span class="rel">{{ rel(d.lastInformAt) }}</span></td>
                      <td><b>{{ d.manufacturer || '—' }}</b> <span class="mut">{{ d.modelName || d.productClass || '' }}</span></td>
                      <td class="mono">{{ d.serialNumber || '—' }}</td>
                      <td>
                        @if (d.contrato) { <span class="mono">{{ d.contrato }}</span> }
                        @else { <span class="tagw">sin contrato</span> }
                      </td>
                      <td class="mono">{{ d.ipCliente || '—' }}</td>
                      <td class="mono">{{ d.ipKlax || '—' }}</td>
                      <td class="mono sm">{{ d.softwareVersion || '—' }}</td>
                      <td><span class="tag">{{ d.dataModel || '—' }}</span></td>
                      <td class="sm mono">{{ d.ssid || '—' }}</td>
                      <td class="sm" [title]="d.lastInformAt || ''">{{ abs(d.lastInformAt) }}</td>
                      <td>@if (d.hasConnReq) { <span class="ok-dot">✔</span> } @else { <span class="mut">—</span> }</td>
                      <td class="go">›</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          } @else {
            <div class="empty">
              @if (q) { Sin resultados para "{{ q }}". }
              @else { Todavía ningún router hizo Inform. }
            </div>
          }
        </div>
      }

      @if (tab() === 'config') {
        <div class="row2">
          <div class="card">
            <div class="ch">Configuración</div>
            <div class="cb">
              <label class="lbl">URL del ACS</label>
              <div class="inline">
                <input class="inp" [(ngModel)]="cfg.acs_public_url" placeholder="http://tu-noc:8085">
                <button class="btn" (click)="save()">Guardar</button>
              </div>
              <div class="url"><span class="mono">{{ cfg.acs_url }}</span>
                <button class="btn ghost xs" (click)="copiar(cfg.acs_url)">Copiar</button></div>
              <div class="grid2" style="margin-top:12px">
                <div><label class="lbl">Usuario ACS (va en el router)</label>
                  <input class="inp" [(ngModel)]="cfg.auth_username" placeholder="ej. inno-acs (vacío = abierto)"></div>
                <div><label class="lbl">Clave ACS (va en el router)</label>
                  <input class="inp" [(ngModel)]="cfg.auth_password" placeholder="clave para los routers"></div>
              </div>
              <div class="grid2">
                <div><label class="lbl">Intervalo Inform (s)</label>
                  <input class="inp" type="number" [(ngModel)]="cfg.inform_interval_seconds"></div>
                <div><label class="lbl">Expiración tareas (s)</label>
                  <input class="inp" type="number" [(ngModel)]="cfg.task_ttl_seconds"></div>
              </div>
              <label class="chk"><input type="checkbox" [(ngModel)]="cfg.write_enabled"> Escritura habilitada (reboot / WiFi)</label>
              <label class="chk"><input type="checkbox" [(ngModel)]="cfg.wifi_optimize_enabled"> Optimización WiFi automática (nocturna, 03:15)</label>
              <div class="actions">
                <button class="btn pri" (click)="save()">Guardar configuración</button>
                @if (msg()) { <span class="ok-msg">{{ msg() }}</span> }
              </div>
            </div>
          </div>

          <div class="card">
            <div class="ch">Empujar config a un router</div>
            <div class="cb">
              <label class="lbl">Contrato del cliente</label>
              <div class="inline">
                <input class="inp" [(ngModel)]="contrato" placeholder="Ej. 203619">
                <button class="btn" (click)="push()">Empujar</button>
              </div>
              @if (pushMsg()) { <div class="ok-msg" style="margin-top:8px">{{ pushMsg() }}</div> }
            </div>
          </div>
        </div>
      }
    </div>

    @if (selDevice(); as d) {
      <div class="acsov" (click)="closeModal()">
        <div class="acsmd" (click)="$event.stopPropagation()">
          <div class="mh">
            <div class="mhx">
              <div class="mt"><b>{{ d.manufacturer || 'Router' }}</b> {{ d.modelName || d.productClass || '' }}</div>
              <div class="ms mono">{{ d.serialNumber || '—' }}</div>
            </div>
            <span class="pill" [class.on]="dOnline(d)">{{ dOnline(d) ? 'online' : (d.status || '—') }}</span>
            <button class="x" (click)="closeModal()">✕</button>
          </div>
          <div class="mb">
            <div class="dgrid">
              <div><span>Contrato</span><b class="mono">{{ d.contrato || '—' }}</b></div>
              <div><span>IP cliente</span><b class="mono">{{ d.ipCliente || '—' }}</b></div>
              <div><span>IP KLAX</span><b class="mono">{{ d.ipKlax || '—' }}</b></div>
              <div><span>Firmware</span><b>{{ d.softwareVersion || '—' }}</b></div>
              <div><span>Hardware</span><b>{{ d.hardwareVersion || '—' }}</b></div>
              <div><span>Modelo datos</span><b>{{ d.dataModel || '—' }}</b></div>
              <div><span>WiFi (SSID)</span><b>{{ d.ssid || '—' }}</b></div>
              <div><span>MAC</span><b class="mono">{{ d.macAddress || '—' }}</b></div>
              <div><span>OUI</span><b class="mono">{{ d.oui || '—' }}</b></div>
              <div><span>Product Class</span><b>{{ d.productClass || '—' }}</b></div>
              <div><span>IP origen</span><b class="mono">{{ d.ipOrigen || '—' }}</b></div>
              <div><span>OLT</span><b>{{ d.oltName || '—' }}</b></div>
              <div><span>PON · ONU</span><b>{{ (d.pon || '—') }} · {{ (d.onuId || '—') }}</b></div>
              <div><span>Último Inform</span><b>{{ abs(d.lastInformAt) }} <span class="mut">({{ rel(d.lastInformAt) }})</span></b></div>
              <div><span>Último boot</span><b>{{ abs(d.lastBootAt) }}</b></div>
              <div><span>Último evento</span><b>{{ d.lastEventCode || '—' }}</b></div>
              <div><span>Registrado</span><b>{{ abs(d.createdAt) }}</b></div>
              <div><span>ConnReq</span><b>{{ d.hasConnReq ? 'disponible' : '—' }}</b></div>
            </div>

            @if (d.contrato) {
              <div class="msec">Acciones</div>
              <div class="dacts">
                <button class="btn pri" (click)="optimizar(d)" title="Canal automático (menos interferencia) + potencia máxima">✨ Optimizar WiFi</button>
                <button class="btn" (click)="refresh(d)">🔄 Refrescar</button>
                <button class="btn" (click)="reboot(d)">♻ Reiniciar</button>
                <button class="btn" (click)="connreq(d)">📡 Connection Request</button>
                <button class="btn" (click)="wifiEdit.set('nombre')">✏️ Cambiar nombre WiFi</button>
                <button class="btn" (click)="wifiEdit.set('clave')">🔑 Cambiar clave WiFi</button>
              </div>
              <div class="msec">WiFi</div>
              <div class="wifinow">
                <div><span>Nombre (SSID)</span><b>{{ d.ssid || '—' }}</b></div>
                <div><span>Clave</span><b class="mono">{{ d.wifiPassword || '—' }}</b></div>
                <div><span>Canal</span><b>{{ d.wifiChannel || '—' }}</b></div>
                <div><span>Dispositivos conectados</span><b class="link" (click)="toggleHosts(d)">{{ d.connectedHosts == null ? '—' : d.connectedHosts }} <span class="mut">{{ hostsOpen() ? '▲' : '▼' }}</span></b></div>
              </div>
              @if (hostsOpen()) {
                <div class="hostbox">
                  <div class="hosthd">
                    <span>Conectados{{ hosts().length ? ' (' + hosts().length + ')' : '' }}</span>
                    <span class="live" title="Se actualiza solo">● En vivo</span>
                  </div>
                  @if (hosts().length) {
                    <div class="htw"><table class="htab">
                      <thead><tr><th>Nombre</th><th>IP</th><th>MAC</th><th>Interfaz</th><th></th></tr></thead>
                      <tbody>
                        @for (h of hosts(); track h.mac) {
                          <tr>
                            <td>{{ h.name || '—' }}</td>
                            <td class="mono">{{ h.ip || '—' }}</td>
                            <td class="mono">{{ h.mac || '—' }}</td>
                            <td>{{ h.iface || '—' }}</td>
                            <td>{{ (h.active === 'true' || h.active === '1') ? '🟢' : '⚪' }}</td>
                          </tr>
                        }
                      </tbody>
                    </table></div>
                  } @else {
                    <div class="tkempty">Leyendo del router… la lista aparece en su próximo contacto (unos segundos).</div>
                  }
                </div>
              }
              <div class="msec">Tareas recientes</div>
              @if (tareas().length) {
                <div class="tks">
                  @for (t of tareas(); track t.id) {
                    <div class="tk">
                      <span [class]="taskCls(t.status)">{{ taskLabel(t.status) }}</span>
                      <span class="tkn">{{ taskName(t) }}</span>
                      <span class="tkt">{{ t.createdBy || 'sistema' }} · {{ rel(t.createdAt) }}</span>
                      @if (t.errorMessage) { <span class="tke">⚠ {{ t.errorMessage }}</span> }
                    </div>
                  }
                </div>
              } @else {
                <div class="tkempty">Sin tareas todavía.</div>
              }
            } @else {
              <div class="msec">Asignar contrato</div>
              <div class="inline">
                <input class="inp" [(ngModel)]="asignar[d.id]" placeholder="Contrato del cliente">
                <button class="btn pri" (click)="asignarContrato(d)">Asignar</button>
              </div>
            }
          </div>
        </div>
      </div>
      @if (wifiEdit()) {
        <div class="acsov2" (click)="wifiEdit.set(null)">
          <div class="acsmd2" (click)="$event.stopPropagation()">
            <div class="mh">
              <div class="mhx"><div class="mt">{{ wifiEdit() === 'nombre' ? 'Cambiar nombre WiFi' : 'Cambiar clave WiFi' }}</div></div>
              <button class="x" (click)="wifiEdit.set(null)">✕</button>
            </div>
            <div class="mb">
              @if (wifiEdit() === 'nombre') {
                <label class="lbl">Nuevo nombre (SSID)</label>
                <input class="inp full" [(ngModel)]="wifiNombre" placeholder="Ej. Bryan 007">
                <div class="mbtns"><button class="btn pri" (click)="wifiNom(d)">Guardar</button></div>
              } @else {
                <label class="lbl">Nueva clave (mín. 8)</label>
                <input class="inp full" [(ngModel)]="wifiClave" placeholder="Nueva clave WiFi">
                <div class="mbtns"><button class="btn pri" (click)="wifiPass(d)">Guardar</button></div>
              }
            </div>
          </div>
        </div>
      }
    }
  `,
  styles: [`
    :host { display:block; --pri:#7c0061; --ink:#1a1526; --mut:#8a8296; --line:#ece8f1; }
    .acs { max-width:1240px; margin:0 auto; padding:14px 18px 60px; color:var(--ink); }
    .hd { margin-bottom:12px; }
    .ttl { font-weight:800; font-size:19px; display:flex; align-items:center; gap:8px; }
    .ttl .tr { font-size:11px; font-weight:700; color:var(--pri); background:#f3eef7; padding:2px 8px; border-radius:999px; }
    .sub { color:var(--mut); font-size:13px; margin-top:2px; }

    .tabs { display:flex; gap:4px; border-bottom:1px solid var(--line); margin-bottom:16px; }
    .tab { border:none; background:transparent; padding:10px 16px; font-size:13.5px; font-weight:700; color:var(--mut); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
    .tab:hover { color:var(--ink); }
    .tab.act { color:var(--pri); border-bottom-color:var(--pri); }

    .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:14px; }
    @media(max-width:720px){ .kpis { grid-template-columns:repeat(2,1fr); } }
    .kpi { background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px 16px; box-shadow:0 1px 2px rgba(26,21,38,.04); }
    .kpi .kn { font-size:22px; font-weight:800; line-height:1; }
    .kpi .kl { font-size:12px; color:var(--mut); font-weight:600; margin-top:5px; }
    .kpi.ok .kn { color:#16a34a; }
    .kpi.warn .kn { color:#d97706; }

    .row2 { display:grid; grid-template-columns:1.3fr 1fr; gap:14px; align-items:start; }
    @media(max-width:840px){ .row2 { grid-template-columns:1fr; } }

    .card { background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:0 1px 2px rgba(26,21,38,.04),0 6px 24px rgba(26,21,38,.05); overflow:hidden; margin-bottom:14px; }
    .ch { font-weight:700; font-size:13.5px; padding:13px 16px; border-bottom:1px solid var(--line); background:#faf9fc; }
    .ch.bar { display:flex; align-items:center; gap:12px; }
    .ch.bar > span:first-child { margin-right:auto; }
    .cnt { font-size:11px; font-weight:700; color:var(--pri); background:#f3eef7; padding:2px 8px; border-radius:999px; margin-left:6px; }
    .cb { padding:14px 16px; }

    .lbl { display:block; font-size:11px; font-weight:700; color:var(--mut); text-transform:uppercase; letter-spacing:.3px; margin:0 0 5px; }
    .inline { display:flex; gap:8px; align-items:center; }
    .inp { flex:1; min-width:0; height:36px; border:1px solid var(--line); border-radius:9px; padding:0 11px; font-size:13px; font-family:inherit; outline:none; }
    .inp:focus { border-color:var(--pri); }
    .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px; }
    .url { display:flex; align-items:center; gap:8px; margin-top:8px; font-size:12px; color:var(--mut); flex-wrap:wrap; }
    .url .mono { color:var(--ink); }
    .chk { display:flex; align-items:center; gap:8px; margin:14px 0 4px; font-size:13px; cursor:pointer; }
    .actions { margin-top:12px; display:flex; align-items:center; }
    .ok-msg { margin-left:10px; color:#16a34a; font-size:12.5px; font-weight:600; }

    .btn { height:36px; border:1px solid var(--line); background:#fff; border-radius:9px; padding:0 14px; font-weight:600; font-size:13px; cursor:pointer; display:inline-flex; align-items:center; gap:6px; color:var(--ink); white-space:nowrap; }
    .btn:hover { background:#faf8fc; }
    .btn.pri { background:var(--pri); color:#fff; border-color:var(--pri); }
    .btn.pri:hover { filter:brightness(1.06); }
    .btn.ghost { background:transparent; }
    .btn.xs { height:27px; padding:0 9px; font-size:12px; border-radius:7px; }

    .search { height:32px; border:1px solid var(--line); border-radius:9px; padding:0 11px; font-size:12.5px; width:280px; max-width:42vw; outline:none; }
    .search:focus { border-color:var(--pri); }
    .live { font-size:11.5px; font-weight:700; color:#16a34a; display:inline-flex; align-items:center; gap:4px; white-space:nowrap; }

    .tw { overflow:auto; }
    table { width:100%; border-collapse:collapse; font-size:12.5px; }
    thead th { text-align:left; color:var(--mut); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:.3px; padding:9px 10px; border-bottom:1px solid var(--line); white-space:nowrap; background:#fbfafc; }
    tbody td { padding:9px 10px; border-bottom:1px solid #f4f1f7; vertical-align:middle; }
    .drow.click { cursor:pointer; }
    .drow:hover { background:#f9f6fc; }
    .mono { font-family:'Consolas','SFMono-Regular',monospace; }
    .sm { font-size:11.5px; }
    .mut { color:var(--mut); }
    .st { display:inline-block; width:8px; height:8px; border-radius:50%; background:#9ca3af; margin-right:7px; vertical-align:middle; }
    .st.on { background:#16a34a; box-shadow:0 0 0 3px rgba(22,163,74,.15); }
    .rel { font-size:11.5px; color:var(--mut); }
    .tag { display:inline-block; font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:6px; background:#eef2ff; color:#4338ca; }
    .tagw { display:inline-block; font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:6px; background:#fff4e5; color:#b45309; }
    .ok-dot { color:#16a34a; font-weight:800; }
    .go { color:var(--mut); font-size:18px; font-weight:700; text-align:right; }

    .empty { padding:26px 16px; text-align:center; color:var(--mut); font-size:13px; }

    /* Modal */
    .acsov { position:fixed; inset:0; background:rgba(26,21,38,.42); backdrop-filter:blur(2px); -webkit-backdrop-filter:blur(2px); display:flex; align-items:center; justify-content:center; z-index:100050; padding:20px; }
    .acsmd { background:#fff; border-radius:18px; width:100%; max-width:720px; max-height:88vh; overflow:auto; box-shadow:0 24px 70px rgba(26,21,38,.3); z-index:100051; }
    .mh { display:flex; align-items:center; gap:12px; padding:16px 18px; border-bottom:1px solid var(--line); position:sticky; top:0; background:#fff; }
    .mhx { margin-right:auto; }
    .mt { font-size:15.5px; font-weight:800; }
    .ms { font-size:12px; color:var(--mut); margin-top:2px; }
    .pill { font-size:11px; font-weight:800; padding:3px 10px; border-radius:999px; background:#f1f0f3; color:#6b6577; text-transform:uppercase; letter-spacing:.3px; }
    .pill.on { background:#eafaf0; color:#16794a; }
    .x { border:none; background:transparent; font-size:16px; color:var(--mut); cursor:pointer; width:30px; height:30px; border-radius:8px; }
    .x:hover { background:#f4f1f7; color:var(--ink); }
    .mb { padding:16px 18px 20px; }
    .dgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px 18px; }
    @media(max-width:560px){ .dgrid { grid-template-columns:repeat(2,1fr); } }
    .dgrid > div { display:flex; flex-direction:column; }
    .dgrid span { font-size:10.5px; color:var(--mut); font-weight:600; text-transform:uppercase; letter-spacing:.3px; }
    .dgrid b { font-size:13px; margin-top:2px; }
    .msec { font-size:11px; font-weight:700; color:var(--mut); text-transform:uppercase; letter-spacing:.4px; margin:18px 0 9px; padding-top:14px; border-top:1px solid var(--line); }
    .dacts { display:flex; gap:8px; flex-wrap:wrap; }
    .wifinow { display:grid; grid-template-columns:repeat(3,1fr); gap:10px 18px; margin-bottom:12px; }
    @media(max-width:560px){ .wifinow { grid-template-columns:repeat(2,1fr); } }
    .wifinow > div { display:flex; flex-direction:column; }
    .wifinow span { font-size:10.5px; color:var(--mut); font-weight:600; text-transform:uppercase; letter-spacing:.3px; }
    .wifinow b { font-size:13px; margin-top:2px; }
    .wifi { display:flex; flex-direction:column; gap:9px; }
    .link { color:var(--pri); cursor:pointer; }
    .wifibtns { display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; }
    .hostbox { border:1px solid var(--line); border-radius:10px; padding:10px 12px; margin-bottom:6px; }
    .hosthd { display:flex; align-items:center; gap:10px; margin-bottom:8px; font-weight:700; font-size:12.5px; }
    .hosthd span:first-child { margin-right:auto; }
    .htw { overflow:auto; }
    .htab { width:100%; border-collapse:collapse; font-size:12px; }
    .htab th { text-align:left; color:var(--mut); font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:.3px; padding:5px 8px; border-bottom:1px solid var(--line); white-space:nowrap; }
    .htab td { padding:5px 8px; border-bottom:1px solid #f4f1f7; }
    .acsov2 { position:fixed; inset:0; background:rgba(26,21,38,.35); backdrop-filter:blur(2px); display:flex; align-items:center; justify-content:center; z-index:100060; padding:20px; }
    .acsmd2 { background:#fff; border-radius:16px; width:100%; max-width:420px; box-shadow:0 24px 70px rgba(26,21,38,.3); z-index:100061; }
    .inp.full { width:100%; flex:none; }
    .mbtns { margin-top:14px; }
    .tks { display:flex; flex-direction:column; gap:6px; }
    .tk { display:flex; align-items:center; gap:10px; padding:7px 10px; border:1px solid var(--line); border-radius:9px; font-size:12.5px; flex-wrap:wrap; }
    .tst { font-size:10.5px; font-weight:800; padding:2px 8px; border-radius:6px; text-transform:uppercase; letter-spacing:.3px; }
    .tst.pend { background:#fff4e5; color:#b45309; }
    .tst.snt { background:#eef2ff; color:#4338ca; }
    .tst.ok { background:#eafaf0; color:#16794a; }
    .tst.err { background:#fdecec; color:#b42318; }
    .tst.exp { background:#f1f0f3; color:#6b6577; }
    .tkn { font-weight:600; }
    .tkt { color:var(--mut); font-size:11.5px; margin-left:auto; }
    .tke { width:100%; color:#b42318; font-size:11.5px; }
    .tkempty { font-size:12.5px; color:var(--mut); }
  `],
})
export class AcsConfig implements OnInit, OnDestroy {
  private api = inject(NocApi);
  private notify = inject(NocNotify);
  cfg: any = { acs_public_url: '', acs_url: '', write_enabled: false, inform_interval_seconds: 900, task_ttl_seconds: 86400 };
  msg = signal(''); pushMsg = signal(''); contrato = '';
  devices = signal<any[]>([]);
  asignar: any = {};
  q = '';
  tab = signal<'panel' | 'config'>('panel');
  sel = signal<number | null>(null);
  wifiNombre = ''; wifiClave = '';
  tareas = signal<any[]>([]);
  hosts = signal<any[]>([]);
  hostsOpen = signal(false);
  wifiEdit = signal<'nombre' | 'clave' | null>(null);
  private openSet = new Set<number>();
  private timer: any = null;

  ngOnInit() { this.load(); this.loadDevices(); this.timer = setInterval(() => this.tick(), 8000); }
  private tick() { this.loadDevices(); const d = this.selDevice(); if (d && d.contrato) { this.loadTareas(d.contrato); if (this.hostsOpen()) this.loadHosts(d.contrato); } }
  loadTareas(contrato: string) { this.api.acsTareas(contrato).subscribe({ next: (t) => this.tareas.set(t || []), error: () => {} }); }
  toggleHosts(d: any) { const o = !this.hostsOpen(); this.hostsOpen.set(o); if (o && d.contrato) { this.loadHosts(d.contrato); this.leerHosts(d); } }
  loadHosts(contrato: string) { this.api.acsHosts(contrato).subscribe({ next: (r) => { try { this.hosts.set(r && r.hostsJson ? JSON.parse(r.hostsJson) : []); } catch { this.hosts.set([]); } }, error: () => this.hosts.set([]) }); }
  leerHosts(d: any) { this.api.acsLeerHosts(d.contrato).subscribe({ next: () => { if (d.contrato) this.loadTareas(d.contrato); }, error: () => {} }); }
  ngOnDestroy() { if (this.timer) { clearInterval(this.timer); this.timer = null; } }

  @HostListener('document:keydown.escape') onEsc() { if (this.sel() !== null) this.closeModal(); }

  load() { this.api.acsConfig().subscribe((c) => (this.cfg = c)); }
  loadDevices() { this.api.acsDevices().subscribe((d) => this.devices.set(d || [])); }

  save() {
    this.api.acsSaveConfig(this.cfg).subscribe({
      next: (c) => { this.cfg = c; this.msg.set('✅ Guardado'); setTimeout(() => this.msg.set(''), 2500); this.notify.ok('Configuración del ACS guardada.'); },
      error: (e: any) => this.notify.error(e?.message || 'No se pudo guardar la configuración del ACS.'),
    });
  }
  push() {
    if (!this.contrato.trim()) { this.pushMsg.set('Escribe el contrato del cliente.'); return; }
    this.api.acsPushMgmt(this.contrato.trim(), {}).subscribe({
      next: () => this.pushMsg.set('✅ Config encolada para el router'),
      error: (e: any) => this.pushMsg.set('⚠ ' + (e?.error?.mensaje || 'No se pudo encolar')),
    });
  }
  asignarContrato(d: any) {
    const c = (this.asignar[d.id] || '').trim();
    if (!c) return;
    this.api.acsAsignarContrato(d.id, c).subscribe({
      next: () => { this.notify.ok('Contrato asignado.'); this.asignar[d.id] = ''; this.loadDevices(); },
      error: (e: any) => this.notify.error(e?.error?.mensaje || 'No se pudo asignar el contrato.'),
    });
  }

  refresh(d: any) { this.api.acsRefresh(d.contrato).subscribe({ next: () => this.notify.ok('Refrescar encolado.'), error: (e: any) => this.notify.error(e?.message || 'No se pudo encolar.') }); }
  reboot(d: any) { this.api.acsReboot(d.contrato).subscribe({ next: () => this.notify.ok('Reinicio encolado.'), error: (e: any) => this.notify.error(e?.message || 'No se pudo encolar.') }); }
  connreq(d: any) { this.api.acsConnReq(d.contrato).subscribe({ next: () => this.notify.ok('Connection Request enviado.'), error: (e: any) => this.notify.error(e?.message || 'No se pudo enviar.') }); }
  optimizar(d: any) { this.api.acsWifiOptimizar(d.contrato).subscribe({ next: () => { this.notify.ok('Optimización WiFi encolada: canal automático + potencia máxima.'); if (d.contrato) this.loadTareas(d.contrato); }, error: (e: any) => this.notify.error(e?.message || 'No se pudo encolar.') }); }
  taskName(t: any): string { const m: any = { REBOOT:'Reiniciar', GET_PARAMETERS:'Refrescar', SET_WIFI_NAME:'Cambiar nombre WiFi', SET_WIFI_PASSWORD:'Cambiar clave WiFi', PUSH_MGMT:'Empujar config', OPTIMIZE_WIFI:'Optimizar WiFi' }; return m[t?.taskType] || t?.taskType || '—'; }
  taskLabel(s: any): string { const m: any = { PENDING:'pendiente', SENT:'enviado', DONE:'hecho', ERROR:'error', EXPIRED:'expirado' }; return m[String(s||'').toUpperCase()] || String(s||'—').toLowerCase(); }
  taskCls(s: any): string { const v = String(s||'').toUpperCase(); const k = v==='DONE'?'ok':v==='ERROR'?'err':v==='SENT'?'snt':v==='EXPIRED'?'exp':'pend'; return 'tst ' + k; }
  wifiNom(d: any) { const v = this.wifiNombre.trim(); if (!v) return; this.api.acsWifiNombre(d.contrato, v).subscribe({ next: () => { this.notify.ok('Cambio de nombre WiFi encolado.'); this.wifiEdit.set(null); this.loadDevices(); if (d.contrato) this.loadTareas(d.contrato); }, error: (e: any) => this.notify.error(e?.message || 'No se pudo encolar.') }); }
  wifiPass(d: any) { const v = this.wifiClave.trim(); if (v.length < 8) { this.notify.error('La clave WiFi debe tener al menos 8 caracteres.'); return; } this.api.acsWifiClave(d.contrato, v).subscribe({ next: () => { this.notify.ok('Cambio de clave WiFi encolado.'); this.wifiClave = ''; this.wifiEdit.set(null); this.loadDevices(); if (d.contrato) this.loadTareas(d.contrato); }, error: (e: any) => this.notify.error(e?.message || 'No se pudo encolar.') }); }

  // --- modal ---
  openModal(d: any) { this.sel.set(d.id); this.wifiNombre = d.ssid || ''; this.wifiClave = ''; this.tareas.set([]); this.hosts.set([]); this.hostsOpen.set(false); this.wifiEdit.set(null); if (d.contrato) this.loadTareas(d.contrato); }
  closeModal() { this.sel.set(null); }
  selDevice(): any { const id = this.sel(); if (id == null) return null; return this.devices().find((d) => d.id === id) || null; }

  // --- bandeja ---
  filtered(): any[] {
    const t = this.q.trim().toLowerCase();
    const list = this.devices();
    if (!t) return list;
    return list.filter((d) => [d.manufacturer, d.modelName, d.serialNumber, d.contrato, d.ipCliente, d.ipKlax, d.macAddress, d.dataModel, d.oltName, d.productClass]
      .some((v) => String(v == null ? '' : v).toLowerCase().includes(t)));
  }
  nOnline(): number { return this.devices().filter((d) => this.dOnline(d)).length; }
  nSinContrato(): number { return this.devices().filter((d) => !d.contrato).length; }
  nConnReq(): number { return this.devices().filter((d) => d.hasConnReq).length; }

  dOnline(d: any): boolean {
    if (String(d?.status || '').toLowerCase() === 'online') return true;
    const t = this.tms(d?.lastInformAt);
    return t > 0 && (Date.now() - t) < 300000;
  }
  private tms(v: any): number { if (!v) return 0; const t = new Date(v).getTime(); return isNaN(t) ? 0 : t; }
  rel(v: any): string {
    const t = this.tms(v); if (!t) return 'nunca';
    const s = Math.floor((Date.now() - t) / 1000);
    if (s < 60) return 'hace ' + s + 's';
    const m = Math.floor(s / 60); if (m < 60) return 'hace ' + m + 'm';
    const h = Math.floor(m / 60); if (h < 24) return 'hace ' + h + 'h';
    return 'hace ' + Math.floor(h / 24) + 'd';
  }
  abs(v: any): string {
    const t = this.tms(v); if (!t) return '—';
    const dt = new Date(t); const p = (n: number) => String(n).padStart(2, '0');
    return p(dt.getDate()) + '/' + p(dt.getMonth() + 1) + ' ' + p(dt.getHours()) + ':' + p(dt.getMinutes());
  }
  copiar(v: string) { navigator.clipboard?.writeText(v || ''); this.msg.set('📋 Copiado'); setTimeout(() => this.msg.set(''), 1500); }
}
